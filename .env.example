# Never commit .env. Use restrictive file permissions and unique generated secrets: generate
# POSTGRES_PASSWORD and AUTH_SECRET with `openssl rand -hex 32` (two different values).
POSTGRES_PASSWORD=
# Server credentials only. Local Compose always uses admin/admin on loopback.
ADMIN_USERNAME=admin
# At least 15 characters; at most 72 UTF-8 bytes (bcrypt's limit).
ADMIN_PASSWORD=
# Signs sessions and account links: at least 32 characters.
AUTH_SECRET=

# Browser origin(s) residents open: one URL or a comma-separated list, exactly as typed in the
# browser (scheme, host and port), with no credentials, paths, queries or wildcards. The default
# serves this machine only (see APP_BIND_ADDRESS). To open Juntia from other devices, list the
# HTTPS address(es) here and set AUTH_COOKIE_SECURE=true: see docs/deployment.md.
PUBLIC_ORIGIN=http://localhost:7778
# Secure session cookies: false for plain http://localhost, true when every PUBLIC_ORIGIN uses HTTPS.
AUTH_COOKIE_SECURE=false

# Local Compose explicitly uses HTTP and non-Secure cookies.
# A CSV is also supported here, but every entry must be HTTP on localhost, 127.0.0.1 or [::1].
LOCAL_PUBLIC_ORIGIN=http://localhost:7778
# Optional host port; the container always listens on 7778.
APP_PORT=7778
# Host address the server Compose file publishes APP_PORT on. The default, 127.0.0.1, means only a
# reverse proxy on the same host can reach the app. Set 0.0.0.0 (every interface) or a LAN address
# when the proxy runs in another container or on another host, and firewall the port so only the
# proxy can connect. The local Compose file always binds 127.0.0.1.
APP_BIND_ADDRESS=127.0.0.1
IMAGE_TAG=latest
# Reverse proxies whose X-Forwarded-For/Proto headers are trusted: comma-separated IP addresses or
# CIDR networks, as the container sees them. A proxy on the same host reaching the published port
# arrives from the Compose network gateway (for example 172.18.0.1: see
# `docker network inspect juntia_default`); a proxy on another host arrives from its own address.
# Never use * or a network that untrusted clients can connect from. See docs/deployment.md.
TRUSTED_PROXY_IPS=127.0.0.1
# IANA time zone for community events, including daylight-saving transitions.
TZ=Europe/Madrid
# Language of server-generated texts: emails, first-run defaults (categories, tags, community and
# account names) and fallback labels. en (default) or es. Existing data is never renamed; the web
# interface follows each browser's language.
APP_LANGUAGE=en

# Storage budgets for community action PDFs, in whole MiB (1 MiB = 1,048,576 bytes). Every
# stored PDF counts, active or withdrawn, until the administrator purges it: per resident author
# (250 MiB) and for the whole community, technical administrator included (2048 MiB).
ACTION_STORAGE_USER_QUOTA_MB=250
ACTION_STORAGE_COMMUNITY_QUOTA_MB=2048
# Free space (MiB) to keep on the uploads volume: action PDF uploads and statement imports that
# would leave less are refused (default 1024 MiB).
MIN_FREE_DISK_MB=1024

# Invitation and password-recovery emails. Leave both HOST and FROM empty to disable.
SMTP_HOST=
SMTP_PORT=587
# starttls (usually 587), tls (usually 465); none is loopback development only.
SMTP_SECURITY=starttls
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM=
SMTP_TIMEOUT=10

# Optional invitation-only Google sign-in (OAuth client type: Web application).
# Register <each PUBLIC_ORIGIN>/api/auth/google/callback as an authorized redirect URI.
# Keep both empty to retain password-only login.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Optional automatic classification after account validation; never PDF extraction.
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_MODEL=
