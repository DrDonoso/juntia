# https://editorconfig.org
root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true

[{*.py,*.pyi,*.mako,*.toml,uv.lock,.test_durations,*.sh,Dockerfile}]
indent_style = space
indent_size = 4

[*.{ts,tsx,js,jsx,mjs,cjs,json,jsonc,yml,yaml,css,html,svg}]
indent_style = space
indent_size = 2

# Two trailing spaces are a hard line break in Markdown.
[*.md]
trim_trailing_whitespace = false
